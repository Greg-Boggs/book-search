# Optional. Overrides the Syndetics client identifier used for cover fallback.
#
# NOT a secret - the default (`sepup`) is a public identifier visible in the
# page source of multcolib.org, and Syndetics serves covers with no client
# param at all. You do not need this file to deploy.
#
# Measured on 34 real ISBNs: 25 covers with the client, 24 without.
SYNDETICS_CLIENT=sepup
